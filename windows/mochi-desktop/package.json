{
  "name": "mochi-desktop",
  "version": "2.0.1",
  "description": "Mochi desktop companion with radial shortcuts and a focus timer",
  "main": "main.js",
  "author": "Mochi Desktop",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build:win": "electron-builder --win zip --x64",
    "build:mac": "electron-builder --mac zip --arm64"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.mochi.desktop",
    "productName": "Mochi",
    "asar": true,
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "assets/**",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "WINDOWS-README.md",
        "to": "읽어주세요.md"
      }
    ],
    "directories": {
      "output": "../../outputs/Mochi-Windows"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "Mochi-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    }
  }
}
